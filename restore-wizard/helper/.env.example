# Replace this placeholder with a unique random value of at least 32 characters.
# The helper refuses to start while the placeholder remains.
RESTORE_HELPER_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
RESTORE_HELPER_PORT=43127

# Set only when using the helper API from the Stocksite admin page.
RESTORE_UI_ORIGIN=http://localhost:3000

# Optional if entered into the wizard's Local setup form for this helper run.
# Required independently trusted package-signing public key (Ed25519 SPKI DER, base64).
# Obtain this through a trusted channel separate from the restore package.
RESTORE_PACKAGE_SIGNING_PUBLIC_KEY=

# Optional signed manifest source. Both URL and public key must be configured.
# RESTORE_MANIFEST_URL=https://trusted.example.invalid/restore-manifest.json
# RESTORE_MANIFEST_PUBLIC_KEY=
# RESTORE_MANIFEST_TOKEN=

# Recommended: enter local PostgreSQL settings in the wizard's Local setup form.
# They are held only in helper memory. These optional environment values are
# available for controlled local use; never commit a real password in this file.
RESTORE_APP_DB_HOST=127.0.0.1
RESTORE_APP_DB_PORT=5432
RESTORE_APP_DB_USER=
RESTORE_APP_DB_PASSWORD=
RESTORE_APP_DB_NAME=

# Optional: if blank, the helper generates a fresh local-only secret in memory
# and writes it only to the restored site's private backend/.env.
# Never reuse a production JWT secret.
RESTORE_APP_JWT_SECRET=
RESTORE_APP_PORT=5001
